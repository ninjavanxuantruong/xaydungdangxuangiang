          <!DOCTYPE html>
          <html lang="vi">
          <head>
            <meta charset="UTF-8" />
            <title>Tài liệu - <%= type %></title>
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <link rel="stylesheet" href="/public/style.css" />
            <style>
              body {
                margin: 0;
                font-family: "Roboto", Arial, sans-serif;
                background: #fff;
              }
              header.site-header {
                display: flex;
                align-items: center;
                background: #cc0000;
                color: #fff;
                padding: 10px 20px;
              }
              header .logo img {
                height: 60px;
                margin-right: 15px;
              }
              header .title h1 {
                margin: 0;
                font-size: 22px;
                font-weight: bold;
              }
              header .title h2 {
                margin: 0;
                font-size: 16px;
                font-weight: normal;
              }
              .logout-btn {
                margin-left: auto;
                color: #fff;
                text-decoration: none;
                font-weight: bold;
                background: #a00000;
                padding: 6px 12px;
                border-radius: 4px;
              }
              main {
                padding: 20px;
              }
              h2.section-title {
                color: #cc0000;
                margin-bottom: 20px;
              }
              ul.doc-list {
                list-style: none;
                padding: 0;
                display: flex;
                flex-direction: column;
                gap: 12px;
              }
              li.doc-item a {
                display: block;
                background: #d50000;
                color: #fff;
                padding: 15px;
                border-radius: 6px;
                text-decoration: none;
                font-weight: bold;
                transition: background 0.3s;
              }
              li.doc-item a:hover {
                background: #a00000;
              }
              .back-link {
                display: inline-block;
                margin-bottom: 20px;
                text-decoration: none;
                color: #cc0000;
                font-weight: bold;
              }
            </style>
          </head>
          <body>

            <header class="site-header">
              <div class="logo">
                <img src="https://raw.githubusercontent.com/ninjavanxuantruong/xaydungdangxuangiang/main/logo-%20dang-cong-san-vietnam-vector-1.png" 
                     alt="Logo Đảng" />
              </div>
              <div class="title">
                <h1>TƯ LIỆU CÔNG TÁC ĐẢNG</h1>
                <h2>BAN XÂY DỰNG ĐẢNG XÃ XUÂN GIANG</h2>
              </div>
              <% if (process.env.AUTH_MODE === "on") { %>
                <a href="/logout" class="logout-btn">Đăng xuất</a>
              <% } %>
            </header>

            <main>
              <a href="/" class="back-link">⬅️ Quay lại danh sách loại</a>
              <h2 class="section-title">📄 Tài liệu thuộc loại: <%= type %></h2>

              <% if (!docs || docs.length === 0) { %>
                <p>❌ Không có tài liệu nào trong loại này.</p>
              <% } else { %>
                    <ul class="doc-list">
                      <% docs.forEach(doc => { %>
                        <li class="doc-item">
                          <div style="display:flex; align-items:center; gap:10px;">
                            <!-- Link mở xem -->
                            <a href="/viewer?url=<%= encodeURIComponent(doc.url) %>&name=<%= encodeURIComponent(doc.name) %>"
                               style="flex:1;">
                              <%= doc.name %>
                            </a>
                            <!-- Nút download -->
                            <a href="<%= doc.url %>" download
                               style="background:#007bff; color:#fff; padding:10px 15px; border-radius:6px; text-decoration:none; font-weight:bold;">
                              ⬇️ Tải về
                            </a>
                            <!-- Nút tóm tắt: chỉ hiện nếu có dữ liệu ở cột D/E/F -->
                            <% if (doc.summaryD || doc.summaryE || doc.summaryF) { %>
                              <a href="/mindmap/<%= encodeURIComponent(doc.name) %>"
                                 style="background:#28a745; color:#fff; padding:10px 15px; border-radius:6px; text-decoration:none; font-weight:bold;">
                                📑 Tóm tắt
                              </a>
                            <% } %>

                          </div>
                        </li>

                      <% }) %>
                    </ul>

              <% } %>
            </main>

          </body>
          </html>
