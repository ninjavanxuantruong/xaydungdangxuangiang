<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <title>Danh sách báo cáo</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 20px; }
    h2 { margin-bottom: 15px; }
    ul { list-style: none; padding: 0; }
    li { margin: 8px 0; }
    a {
      text-decoration: none;
      color: #007bff;
      font-weight: bold;
    }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <h2>Danh sách báo cáo</h2>
  <ul>
    <% if (reports && reports.length) { %>
      <% reports.forEach(r => { %>
        <li>
          <% if (r.url) { %>
            <a href="/reports/results/<%= encodeURIComponent(r.name) %>"><%= r.displayName %></a>
          <% } else { %>
            <a href="/reports/results/<%= encodeURIComponent(r.name) %>"><%= r.displayName %></a>
          <% } %>
        </li>
      <% }) %>
    <% } else { %>
      <li>Chưa có báo cáo</li>
    <% } %>
  </ul>


  <p><a href="/">⬅ Quay lại trang chính</a></p>
</body>
</html>
